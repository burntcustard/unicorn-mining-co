{
  "name": "unicorn-mining-co",
  "version": "0.1.0",
  "description": "A web game created for Js13kGames",
  "homepage": "https://github.com/burntcustard/unicorn-mining-co#readme",
  "bugs": {
    "url": "https://github.com/burntcustard/unicorn-mining-co/issues"
  },
  "license": "MIT",
  "author": "burntcustard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burntcustard/unicorn-mining-co.git"
  },
  "type": "module",
  "scripts": {
    "backups:delete:live": "node scripts/backups-live.ts --delete",
    "backups:live": "node scripts/backups-live.ts",
    "benchmark": "node benchmarking/rendering/run.ts",
    "benchmark:latency:live": "node benchmarking/latency/run.ts --target live",
    "benchmark:latency:local": "node benchmarking/latency/run.ts --target local",
    "benchmark:npc": "node benchmarking/npc/run.ts",
    "benchmark:npc:collection": "node benchmarking/npc/collection-run.ts",
    "benchmark:npc:prepare": "node benchmarking/npc/fixture.ts",
    "benchmark:pirate:prepare": "node benchmarking/rendering/pirate-fixture.ts",
    "benchmark:server:live": "node benchmarking/server/run.ts --target live",
    "benchmark:server:local": "node benchmarking/server/run.ts --target local",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run font && npm run typecheck && vite build",
    "build:server": "npm run catalog:go && CGO_ENABLED=0 GOEXPERIMENT=simd go build -trimpath -ldflags='-s -w' -o bin/server ./src/server",
    "catalog:go": "node --import tsx scripts/generate-go-catalog.ts",
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:server": "node scripts/dev-server.ts",
    "font": "node scripts/generate-font.ts",
    "format": "oxlint -A correctness --fix . && npm run lint:css -- --fix && oxfmt .",
    "format:check": "oxlint -A correctness . && npm run lint:css && oxfmt --check .",
    "format:go": "node scripts/run-go-formatter.ts",
    "format:go:check": "node scripts/run-go-formatter.ts --check",
    "lint": "oxlint --type-aware --type-check . && npm run lint:css",
    "lint:css": "stylelint \"{src,font}/**/*.css\"",
    "lint:fix": "oxlint --type-aware --type-check --fix . && npm run lint:css -- --fix",
    "preview": "vite preview --host --port 3000",
    "reset-world:live": "node scripts/reset-world-live.ts",
    "reset-world:local": "node scripts/reset-world-local.ts",
    "start:server": "./bin/server",
    "test": "node scripts/test.ts",
    "test:ui": "node --import tsx scripts/check-ui.ts",
    "tool:font-viewer": "vite --config src/tools/font-viewer/vite.config.ts",
    "tool:object-viewer": "vite --config src/tools/game-object-viewer/vite.config.ts",
    "tool:world-viewer": "vite --config src/tools/world-viewer/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@types/clipper-lib": "6.4.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/ws": "^8.18.1",
    "clipper-lib": "6.4.2",
    "fonteditor-core": "2.6.3",
    "html-minifier-terser": "^7.2.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "rolldown": "^1.2.9",
    "stylelint": "^17.16.0",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
