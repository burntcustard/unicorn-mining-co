{
  "name": "unicorn-mining-co",
  "version": "1.0.0",
  "description": "A web game created for Js13kGames",
  "homepage": "https://github.com/burntcustard/unicorn-mining-co#readme",
  "bugs": {
    "url": "https://github.com/burntcustard/unicorn-mining-co/issues"
  },
  "license": "MIT",
  "author": "burntcustard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burntcustard/unicorn-mining-co.git"
  },
  "type": "module",
  "scripts": {
    "benchmark": "node benchmarking/run.mjs",
    "benchmark:simulation": "node benchmarking/simulation.mjs",
    "benchmark:headless": "BENCH_HEADLESS=1 node benchmarking/run.mjs",
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:server": "tsx watch src/server/index.ts",
    "start:server": "node dist/server.js",
    "preview": "vite preview --host --port 3000",
    "world-preview": "node scripts/world-preview.js",
    "build": "npm run typecheck && vite build && node plugins/build-server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:formatting && npm run test:shared && npm run test:simulation && npm run test:regions && npm run test:server && npm run test:packets && npm run test:prediction && npm run test:collisions && npm run test:docked && npm run test:prism && npm run test:sound && npm run test:input",
    "test:formatting": "node tests/formatting.test.mjs",
    "test:shared": "node tests/shared-objects.test.mjs && node tests/rendering.test.mjs",
    "test:simulation": "node tests/simulation.test.mjs && node tests/snapshots.test.mjs",
    "test:regions": "node tests/regions.test.mjs",
    "test:server": "tsx tests/server.test.ts",
    "test:packets": "npm run build && tsx tests/packet-size.test.ts",
    "test:prediction": "tsx tests/prediction.test.ts",
    "test:collisions": "node tests/collisions.test.mjs",
    "test:docked": "node tests/docked.test.mjs && node tests/lazy-docked.test.mjs && node tests/property-mangling.test.mjs",
    "test:input": "node tests/input.test.mjs && node tests/module-input.test.mjs",
    "test:prism": "node tests/prism.test.mjs",
    "test:sound": "node tests/sound.test.mjs",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "oxlint --type-aware --type-check --fix .",
    "format": "oxlint -c .oxlint-format.json --fix . && oxfmt .",
    "format:check": "oxlint -c .oxlint-format.json . && oxfmt --check ."
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
