{
  "name": "unicorn-mining-co",
  "version": "1.0.0",
  "type": "module",
  "description": "A web game created for Js13kGames",
  "scripts": {
    "benchmark": "node benchmarking/run.mjs",
    "dev": "vite",
    "dev:host": "vite --host",
    "world-preview": "node scripts/world-preview.js",
    "build": "npm run build:full",
    "build:fast": "vite build --mode fast",
    "build:full": "vite build --mode full",
    "build:search": "vite build --mode search",
    "test:collisions": "node tests/collisions.test.mjs",
    "test:docked": "node tests/docked.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burntcustard/unicorn-mining-co.git"
  },
  "author": "burntcustard",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/burntcustard/unicorn-mining-co/issues"
  },
  "homepage": "https://github.com/burntcustard/unicorn-mining-co#readme",
  "overrides": {
    "preprocess": "3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "advzip-bin": "^2.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "html-minifier-terser": "^7.2.0",
    "jszip": "^3.10.1",
    "roadroller": "^2.1.0",
    "terser": "^5.50.0",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "advzip-bin@2.0.0": true,
    "core-js-pure@3.50.0": true
  }
}
