@@ -0,0 +1,44 @@
+//go:build goexperiment.simd && amd64
+
+package server
+
+import (
+	"github.com/burntcustard/unicorn-mining-co/internal/utilities"
+	"simd/archsimd"
+)
+
+var vectorReplication = archsimd.X86.AVX2() && utilities.SIMDFeature("replication")
+
+func replicationMasks(x, y []float64, px, py float64, thresholds [5]float64) uint32 {
+	if len(x) < 4 {
+		var flags uint32
+		for i := range x {
+			dx, dy := x[i]-px, y[i]-py
+			d := dx*dx + dy*dy
+			for j, threshold := range thresholds {
+				if d <= threshold {
+					flags |= 1 << (j*4 + i)
+				}
+			}
+			if d > thresholds[1] {
+				flags |= 1 << (20 + i)
+			}
+			if d > thresholds[3] {
+				flags |= 1 << (24 + i)
+			}
+		}
+		return flags
+	}
+	dx := archsimd.LoadFloat64x4(x).Sub(archsimd.BroadcastFloat64x4(px))
+	dy := archsimd.LoadFloat64x4(y).Sub(archsimd.BroadcastFloat64x4(py))
+	d := dx.Mul(dx).Add(dy.Mul(dy))
+	flags := uint32(d.LessEqual(archsimd.BroadcastFloat64x4(thresholds[0])).ToBits())
+	flags |= uint32(d.LessEqual(archsimd.BroadcastFloat64x4(thresholds[1])).ToBits()) << 4
+	flags |= uint32(d.LessEqual(archsimd.BroadcastFloat64x4(thresholds[2])).ToBits()) << 8
+	flags |= uint32(d.LessEqual(archsimd.BroadcastFloat64x4(thresholds[3])).ToBits()) << 12
+	flags |= uint32(d.LessEqual(archsimd.BroadcastFloat64x4(thresholds[4])).ToBits()) << 16
+	flags |= uint32(d.Greater(archsimd.BroadcastFloat64x4(thresholds[1])).ToBits()) << 20
+	flags |= uint32(d.Greater(archsimd.BroadcastFloat64x4(thresholds[3])).ToBits()) << 24
+	archsimd.ClearAVXUpperBits()
+	return flags
+}
