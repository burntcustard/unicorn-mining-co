diff --git a/internal/collision/game/bounds-simd.go b/internal/collision/game/bounds-simd.go
new file mode 100644
index 0000000..75bad74
--- /dev/null
+++ b/internal/collision/game/bounds-simd.go
@@ -0,0 +1,135 @@
+//go:build goexperiment.simd && amd64
+
+package game
+
+import (
+	"github.com/burntcustard/unicorn-mining-co/internal/utilities"
+	"math"
+	"math/bits"
+	"simd/archsimd"
+	"slices"
+)
+
+type broadGeometry struct{ values, sorted []float64 }
+
+var packedBounds = archsimd.X86.AVX2() && (utilities.SIMDFeature("bounds") || utilities.SIMDFeature("bounds-scalar"))
+var vectorBounds = archsimd.X86.AVX2() && utilities.SIMDFeature("bounds")
+
+func (g *GameCollisions) findFreePacked(motions []*BodyRecord) ([]bool, bool) {
+	if !packedBounds {
+		return nil, false
+	}
+	n := len(motions)
+	stride := (n + 3) &^ 3
+	if len(g.geometry.values) < stride*6 {
+		g.geometry.values = make([]float64, stride*12)
+		g.geometry.sorted = make([]float64, stride*8)
+	}
+	if len(g.free) < n {
+		g.free = make([]bool, n*2)
+	}
+	values := g.geometry.values
+	x, y, dx, dy, radius, lower := values[:stride], values[stride:stride*2], values[stride*2:stride*3], values[stride*3:stride*4], values[stride*4:stride*5], values[stride*5:stride*6]
+	for i, r := range motions {
+		p, start := r.Entity.Base().Position, r.SweepStart.Position
+		x[i], y[i] = start.X, start.Y
+		dx[i], dy[i] = p.X-start.X, p.Y-start.Y
+		radius[i] = r.Radius
+		g.free[i] = true
+	}
+	margin := g.catalog.Simulation.Physics.WakeMargin
+	i := 0
+	if vectorBounds {
+		half, wake := archsimd.BroadcastFloat64x4(0.5), archsimd.BroadcastFloat64x4(margin)
+		for ; i+4 <= n; i += 4 {
+			vx, vy := archsimd.LoadFloat64x4(dx[i:]), archsimd.LoadFloat64x4(dy[i:])
+			travel := vx.Mul(vx).Add(vy.Mul(vy)).Sqrt()
+			reach := archsimd.LoadFloat64x4(radius[i:]).Add(travel).Add(wake)
+			cx := archsimd.LoadFloat64x4(x[i:]).Add(vx.Mul(half))
+			cy := archsimd.LoadFloat64x4(y[i:]).Add(vy.Mul(half))
+			reach.Store(radius[i:])
+			cx.Store(x[i:])
+			cy.Store(y[i:])
+			cx.Sub(reach).Store(lower[i:])
+		}
+		archsimd.ClearAVXUpperBits()
+	}
+	for ; i < n; i++ {
+		travel := math.Sqrt(dx[i]*dx[i] + dy[i]*dy[i])
+		radius[i] += travel
+		radius[i] += margin
+		x[i] += dx[i] / 2
+		y[i] += dy[i] / 2
+		lower[i] = x[i] - radius[i]
+	}
+	reuse := len(g.sortOrder) == n
+	if !reuse {
+		g.sortOrder = make([]int, n)
+		for i := range n {
+			g.sortOrder[i] = i
+		}
+	}
+	order := g.sortOrder
+	if reuse {
+		for i := 1; i < n; i++ {
+			item, j := order[i], i-1
+			for j >= 0 && lower[order[j]] > lower[item] {
+				order[j+1] = order[j]
+				j--
+			}
+			order[j+1] = item
+		}
+	} else {
+		slices.SortStableFunc(order, func(a, b int) int {
+			if lower[a] < lower[b] {
+				return -1
+			}
+			if lower[a] > lower[b] {
+				return 1
+			}
+			return 0
+		})
+	}
+	data := g.geometry.sorted
+	lx, cx, cy, reach := data[:stride], data[stride:stride*2], data[stride*2:stride*3], data[stride*3:stride*4]
+	for i, index := range order {
+		lx[i], cx[i], cy[i], reach[i] = lower[index], x[index], y[index], radius[index]
+	}
+	for i := range n {
+		right := cx[i] + reach[i]
+		j := i + 1
+		if vectorBounds && j+4 <= n && lx[j+3] <= right {
+			ax, ay, ar := archsimd.BroadcastFloat64x4(cx[i]), archsimd.BroadcastFloat64x4(cy[i]), archsimd.BroadcastFloat64x4(reach[i])
+			vr := archsimd.BroadcastFloat64x4(right)
+			for ; j+4 <= n; j += 4 {
+				dx, dy := ax.Sub(archsimd.LoadFloat64x4(cx[j:])), ay.Sub(archsimd.LoadFloat64x4(cy[j:]))
+				r := ar.Add(archsimd.LoadFloat64x4(reach[j:]))
+				mask := dx.Mul(dx).Add(dy.Mul(dy)).LessEqual(r.Mul(r)).ToBits()
+				stop := archsimd.LoadFloat64x4(lx[j:]).Greater(vr).ToBits()
+				if stop != 0 {
+					mask &= uint8(1<<bits.TrailingZeros8(stop)) - 1
+				}
+				for mask != 0 {
+					lane := bits.TrailingZeros8(mask)
+					g.free[order[i]], g.free[order[j+lane]] = false, false
+					mask &= mask - 1
+				}
+				if stop != 0 {
+					j = n
+					break
+				}
+			}
+			archsimd.ClearAVXUpperBits()
+		}
+		for ; j < n; j++ {
+			if lx[j] > right {
+				break
+			}
+			dx, dy, r := cx[i]-cx[j], cy[i]-cy[j], reach[i]+reach[j]
+			if dx*dx+dy*dy <= r*r {
+				g.free[order[i]], g.free[order[j]] = false, false
+			}
+		}
+	}
+	return g.free, true
+}
diff --git a/internal/collision/game/bounds-simd_test.go b/internal/collision/game/bounds-simd_test.go
new file mode 100644
index 0000000..1b01332
--- /dev/null
+++ b/internal/collision/game/bounds-simd_test.go
@@ -0,0 +1,53 @@
+//go:build goexperiment.simd && amd64
+
+package game
+
+import (
+	"github.com/burntcustard/unicorn-mining-co/internal/simulation"
+	"github.com/burntcustard/unicorn-mining-co/internal/specification"
+	Vec "github.com/burntcustard/unicorn-mining-co/internal/vector"
+	"math/rand/v2"
+	"reflect"
+	"slices"
+	"testing"
+)
+
+func TestPackedSweptBounds(t *testing.T) {
+	if !packedBounds {
+		t.Skip("AVX2 unavailable or packed bounds disabled")
+	}
+	catalog, err := specification.Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := rand.New(rand.NewPCG(25, 31))
+	oldPacked, oldVector := packedBounds, vectorBounds
+	defer func() { packedBounds, vectorBounds = oldPacked, oldVector }()
+	scalar, packed, vector := NewGameCollisions(catalog), NewGameCollisions(catalog), NewGameCollisions(catalog)
+	for repeat := range 3 {
+		for count := range 129 {
+			motions := make([]*BodyRecord, count)
+			for i := range motions {
+				start := Vec.Create(r.Float64()*1000, r.Float64()*1000)
+				position := Vec.Add(start, Vec.Create(r.Float64()*100-50, r.Float64()*100-50))
+				if repeat == 1 {
+					position, start = Vec.Create(float64(i%5), 0), Vec.Vector{}
+				}
+				e := simulation.NewGameObject(simulation.ObjectProperties{Position: position}, catalog.Simulation)
+				motions[i] = &BodyRecord{Entity: e, SweepStart: simulation.Pose{Position: start}, Radius: r.Float64() * 40}
+			}
+			packedBounds = false
+			want := append([]bool{}, scalar.findFree(motions)[:count]...)
+			packedBounds, vectorBounds = true, false
+			gotPacked := packed.findFree(motions)[:count]
+			vectorBounds = true
+			gotVector := vector.findFree(motions)[:count]
+			if !slices.Equal(want, gotPacked) || !slices.Equal(want, gotVector) {
+				t.Fatalf("free motion differs for repeat=%d count=%d", repeat, count)
+			}
+			if !reflect.DeepEqual(scalar.sortOrder, vector.sortOrder) {
+				t.Fatal("changed stable swept-bound ordering")
+			}
+		}
+	}
+}
