+//go:build goexperiment.simd && amd64
+
+package simulation
+
+import (
+	"github.com/burntcustard/unicorn-mining-co/internal/utilities"
+	"simd/archsimd"
+	"unsafe"
+)
+
+var motionSIMD = archsimd.X86.AVX2() && utilities.SIMDFeature("motion")
+
+func roundMotionSIMD(o *GameObject) bool {
+	if !motionSIMD {
+		return false
+	}
+	scale, half := archsimd.BroadcastFloat64x4(1e8), archsimd.BroadcastFloat64x4(0.5)
+	// The motion fields are consecutive float64s; the layout is verified in tests.
+	values := (*[4]float64)(unsafe.Pointer(&o.Position))
+	angles := (*[2]float64)(unsafe.Pointer(&o.Rotation))
+	archsimd.LoadFloat64x4Array(values).Mul(scale).Add(half).Floor().Div(scale).StoreArray(values)
+	archsimd.LoadFloat64x2Array(angles).Mul(scale.GetLo()).Add(half.GetLo()).Floor().Div(scale.GetLo()).StoreArray(angles)
+	archsimd.ClearAVXUpperBits()
+	return true
+}
