+//go:build goexperiment.simd && amd64
+
+package collision
+
+import (
+	Vec "github.com/burntcustard/unicorn-mining-co/internal/vector"
+	"math"
+	"math/rand/v2"
+	"simd/archsimd"
+	"testing"
+)
+
+func TestSupportVertex(t *testing.T) {
+	if !archsimd.X86.AVX2() {
+		t.Skip("AVX2 unavailable")
+	}
+	before := vectorSupport
+	vectorSupport = true
+	defer func() { vectorSupport = before }()
+	r := rand.New(rand.NewPCG(17, 31))
+	a, b := &BaseShape{Count: 3, Vertices: make([]Vec.Vector, 3)}, &BaseShape{Count: 3, Vertices: make([]Vec.Vector, 3)}
+	for trial := range 100000 {
+		for i := range 3 {
+			a.Vertices[i], b.Vertices[i] = Vec.Vector{r.Float64()*100 - 50, r.Float64()*100 - 50}, Vec.Vector{r.Float64()*100 - 50, r.Float64()*100 - 50}
+		}
+		if trial%19 == 0 {
+			a.Vertices[1] = a.Vertices[0]
+			b.Vertices[2] = b.Vertices[0]
+		}
+		xfA, xfB := Vec.Transform(r.Float64()*100, r.Float64()*100, r.Float64()*6-3), Vec.Transform(r.Float64()*100, r.Float64()*100, r.Float64()*6-3)
+		d := Vec.Vector{r.Float64()*100 - 50, r.Float64()*100 - 50}
+		if trial%17 == 0 {
+			d = Vec.Vector{math.Copysign(0, -1), 0}
+		}
+		var axisA, axisB Vec.Vector
+		Vec.UnrotateInto(&axisA, xfA.Q, Vec.Scale(d, -1))
+		Vec.UnrotateInto(&axisB, xfB.Q, d)
+		wantA, wantB := a.GetSupport(axisA), b.GetSupport(axisB)
+		var pointA, pointB Vec.Vector
+		Vec.TransformInto(&pointA, xfA, a.Vertices[wantA])
+		Vec.TransformInto(&pointB, xfB, b.Vertices[wantB])
+		var got simplexVertex
+		if !supportVertex(&got, a, xfA, b, xfB, d) || got.indexA != wantA || got.indexB != wantB {
+			t.Fatalf("trial=%d indices %d/%d want %d/%d", trial, got.indexA, got.indexB, wantA, wantB)
+		}
+		for _, pair := range [][2]float64{{got.wA.X, pointA.X}, {got.wA.Y, pointA.Y}, {got.wB.X, pointB.X}, {got.wB.Y, pointB.Y}} {
+			if math.Float64bits(pair[0]) != math.Float64bits(pair[1]) {
+				t.Fatalf("trial=%d point %g want %g", trial, pair[0], pair[1])
+			}
+		}
+	}
+}
