index 0000000..0600029
--- /dev/null
+++ b/internal/vector/transforms-simd.go
@@ -0,0 +1,63 @@
+//go:build goexperiment.simd && amd64
+
+// Adapted from math/sincos.go: Copyright 2010 The Go Authors. All rights reserved.
+// BSD license: docs/licenses/go-math.txt. Polynomial coefficients originate
+// in Stephen L. Moshier's Cephes library, as documented in Go's math/sin.go.
+
+package vector
+
+import (
+	"github.com/burntcustard/unicorn-mining-co/internal/utilities"
+	"math"
+	"simd/archsimd"
+)
+
+var pairedTransforms = archsimd.X86.AVX2() && utilities.SIMDFeature("transforms")
+
+func TransformPair(a Vector, angleA float64, b Vector, angleB float64) (TransformValue, TransformValue) {
+	if !pairedTransforms || !(math.Abs(angleA) < 1<<29 && math.Abs(angleB) < 1<<29) || (angleA == 0 && angleB == 0) {
+		return Transform(a.X, a.Y, angleA), Transform(b.X, b.Y, angleB)
+	}
+	s, c := sincosPair(angleA, angleB)
+	return TransformValue{a, RotValue{s.GetElem(0), c.GetElem(0)}}, TransformValue{b, RotValue{s.GetElem(1), c.GetElem(1)}}
+}
+
+// The Go math.Sincos range reduction and polynomials, evaluated for two bodies
+// together without fused multiply/add. See docs/licenses/go-math.txt.
+func sincosPair(a, b float64) (archsimd.Float64x2, archsimd.Float64x2) {
+	input := archsimd.LoadFloat64x2([]float64{a, b})
+	x := input.Abs()
+	one, half := archsimd.BroadcastFloat64x2(1), archsimd.BroadcastFloat64x2(0.5)
+	j := x.Mul(archsimd.BroadcastFloat64x2(4 / math.Pi)).Floor()
+	j = j.Add(j.Sub(j.Mul(half).Floor().Mul(archsimd.BroadcastFloat64x2(2))))
+	z := x.Sub(j.Mul(archsimd.BroadcastFloat64x2(7.85398125648498535156e-1)))
+	z = z.Sub(j.Mul(archsimd.BroadcastFloat64x2(3.77489470793079817668e-8)))
+	z = z.Sub(j.Mul(archsimd.BroadcastFloat64x2(2.69515142907905952645e-15)))
+	phase := j.Sub(j.Mul(archsimd.BroadcastFloat64x2(0.125)).Floor().Mul(archsimd.BroadcastFloat64x2(8)))
+	reflected := phase.Greater(archsimd.BroadcastFloat64x2(3))
+	phase = phase.Sub(archsimd.BroadcastFloat64x2(4)).IfElse(reflected, phase)
+	swap := phase.Greater(one)
+	zz := z.Mul(z)
+	sp := archsimd.BroadcastFloat64x2(1.58962301576546568060e-10)
+	cp := archsimd.BroadcastFloat64x2(-1.13585365213876817300e-11)
+	sp = sp.Mul(zz).Add(archsimd.BroadcastFloat64x2(-2.50507477628578072866e-8))
+	cp = cp.Mul(zz).Add(archsimd.BroadcastFloat64x2(2.08757008419747316778e-9))
+	sp = sp.Mul(zz).Add(archsimd.BroadcastFloat64x2(2.75573136213857245213e-6))
+	cp = cp.Mul(zz).Add(archsimd.BroadcastFloat64x2(-2.75573141792967388112e-7))
+	sp = sp.Mul(zz).Add(archsimd.BroadcastFloat64x2(-1.98412698295895385996e-4))
+	cp = cp.Mul(zz).Add(archsimd.BroadcastFloat64x2(2.48015872888517045348e-5))
+	sp = sp.Mul(zz).Add(archsimd.BroadcastFloat64x2(8.33333333332211858878e-3))
+	cp = cp.Mul(zz).Add(archsimd.BroadcastFloat64x2(-1.38888888888730564116e-3))
+	sp = sp.Mul(zz).Add(archsimd.BroadcastFloat64x2(-1.66666666666666307295e-1))
+	cp = cp.Mul(zz).Add(archsimd.BroadcastFloat64x2(4.16666666666665929218e-2))
+	s := z.Add(z.Mul(zz).Mul(sp))
+	c := one.Sub(half.Mul(zz)).Add(zz.Mul(zz).Mul(cp))
+	s, c = c.IfElse(swap, s), s.IfElse(swap, c)
+	negative := input.Less(archsimd.BroadcastFloat64x2(0))
+	signS := negative.ToInt64x2().Xor(reflected.ToInt64x2()).ShiftAllLeft(63)
+	signC := reflected.ToInt64x2().Xor(swap.ToInt64x2()).ShiftAllLeft(63)
+	s = s.AsInt64x2().Xor(signS).AsFloat64x2()
+	c = c.AsInt64x2().Xor(signC).AsFloat64x2()
+	s = input.IfElse(input.Equal(archsimd.BroadcastFloat64x2(0)), s)
+	return s, c
+}
diff --git a/internal/vector/transforms_test.go b/internal/vector/transforms_test.go
new file mode 100644
index 0000000..261ce50
--- /dev/null
+++ b/internal/vector/transforms_test.go
@@ -0,0 +1,43 @@
+package vector
+
+import (
+	"math"
+	"math/rand/v2"
+	"testing"
+)
+
+func TestTransformPair(t *testing.T) {
+	angles := []float64{0, math.Copysign(0, -1), math.Inf(1), math.Inf(-1), math.NaN(), math.SmallestNonzeroFloat64, math.MaxFloat64, 1 << 29}
+	for i := -32; i <= 32; i++ {
+		a := float64(i) * math.Pi / 4
+		angles = append(angles, math.Nextafter(a, math.Inf(-1)), a, math.Nextafter(a, math.Inf(1)))
+	}
+	r := rand.New(rand.NewPCG(7, 23))
+	for range 100000 {
+		angles = append(angles, (r.Float64()-0.5)*2*(1<<29), (r.Float64()-0.5)*2*math.Pi)
+	}
+	a, b := Vector{3, -4}, Vector{-8, 6}
+	for i, angle := range angles {
+		other := angles[len(angles)-i-1]
+		x, y := TransformPair(a, angle, b, other)
+		wantX, wantY := Transform(a.X, a.Y, angle), Transform(b.X, b.Y, other)
+		for _, pair := range [][2]float64{{x.Q.S, wantX.Q.S}, {x.Q.C, wantX.Q.C}, {y.Q.S, wantY.Q.S}, {y.Q.C, wantY.Q.C}} {
+			if math.Float64bits(pair[0]) != math.Float64bits(pair[1]) {
+				t.Fatalf("angles %.17g / %.17g: got %.17g (%x), want %.17g (%x)", angle, other, pair[0], math.Float64bits(pair[0]), pair[1], math.Float64bits(pair[1]))
+			}
+		}
+		if x.P != a || y.P != b {
+			t.Fatal("positions changed")
+		}
+	}
+}
+
+var transformResult [2]TransformValue
+
+func BenchmarkTransformPair(b *testing.B) {
+	p, q := Vector{3, -4}, Vector{-8, 6}
+	for i := 0; i < b.N; i++ {
+		a := float64(i&1023) * (math.Pi / 512)
+		transformResult[0], transformResult[1] = TransformPair(p, a, q, -a/3)
+	}
+}
