+//go:build goexperiment.simd && amd64
+
+package server
+
+import (
+	"math"
+	"math/rand/v2"
+	"simd/archsimd"
+	"testing"
+)
+
+func TestReplicationMasks(t *testing.T) {
+	if !archsimd.X86.AVX2() {
+		t.Skip("AVX2 unavailable")
+	}
+	r := rand.New(rand.NewPCG(7, 29))
+	for n := 0; n <= 4; n++ {
+		for trial := 0; trial < 10000; trial++ {
+			x, y := make([]float64, n), make([]float64, n)
+			px, py := r.Float64()*100, r.Float64()*100
+			for i := range x {
+				x[i], y[i] = r.Float64()*100, r.Float64()*100
+			}
+			thresholds := [5]float64{100, 1000, 10000, 20000, 2000}
+			if n > 0 {
+				dx, dy := x[0]-px, y[0]-py
+				d := dx*dx + dy*dy
+				thresholds = [5]float64{d, math.Nextafter(d, math.Inf(-1)), math.Nextafter(d, math.Inf(1)), d, d}
+				if trial%17 == 0 {
+					x[0] = math.NaN()
+				}
+				if trial%19 == 0 {
+					y[0] = math.Inf(1)
+				}
+			}
+			var want uint32
+			for i := range x {
+				dx, dy := x[i]-px, y[i]-py
+				d := dx*dx + dy*dy
+				for j, threshold := range thresholds {
+					if d <= threshold {
+						want |= 1 << (j*4 + i)
+					}
+				}
+				if d > thresholds[1] {
+					want |= 1 << (20 + i)
+				}
+				if d > thresholds[3] {
+					want |= 1 << (24 + i)
+				}
+			}
+			if got := replicationMasks(x, y, px, py, thresholds); got != want {
+				t.Fatalf("n=%d trial=%d got %x want %x", n, trial, got, want)
+			}
+		}
+	}
+}
