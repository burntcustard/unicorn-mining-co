new file mode 100644
index 0000000..a4b66bd
--- /dev/null
+++ b/internal/collision/support-simd.go
@@ -0,0 +1,41 @@
+//go:build goexperiment.simd && amd64
+
+package collision
+
+import (
+	"github.com/burntcustard/unicorn-mining-co/internal/utilities"
+	Vec "github.com/burntcustard/unicorn-mining-co/internal/vector"
+	"math"
+	"simd/archsimd"
+)
+
+var vectorSupport = archsimd.X86.AVX2() && utilities.SIMDFeature("support")
+
+func supportVertex(v *simplexVertex, a *BaseShape, xfA Vec.TransformValue, b *BaseShape, xfB Vec.TransformValue, direction Vec.Vector) bool {
+	if !vectorSupport || a.Count != 3 || b.Count != 3 {
+		return false
+	}
+	pair := func(a, b float64) archsimd.Float64x2 {
+		return archsimd.BroadcastFloat64x2(a).SetElem(1, b)
+	}
+	c, s := pair(xfA.Q.C, xfB.Q.C), pair(xfA.Q.S, xfB.Q.S)
+	dx, dy := pair(direction.X*-1, direction.X), pair(direction.Y*-1, direction.Y)
+	ax := c.Mul(dx).Add(s.Mul(dy))
+	ay := pair(-xfA.Q.S, -xfB.Q.S).Mul(dx).Add(c.Mul(dy))
+	best := archsimd.BroadcastFloat64x2(math.Inf(-1))
+	index := archsimd.BroadcastInt64x2(-1)
+	for i := range 3 {
+		x, y := pair(a.Vertices[i].X, b.Vertices[i].X), pair(a.Vertices[i].Y, b.Vertices[i].Y)
+		value := x.Mul(ax).Add(y.Mul(ay))
+		better := value.Greater(best)
+		best = value.IfElse(better, best)
+		index = archsimd.BroadcastInt64x2(int64(i)).IfElse(better, index)
+	}
+	v.indexA, v.indexB = int(index.GetElem(0)), int(index.GetElem(1))
+	aPoint, bPoint := a.Vertices[v.indexA], b.Vertices[v.indexB]
+	x, y := pair(aPoint.X, bPoint.X), pair(aPoint.Y, bPoint.Y)
+	wx := c.Mul(x).Sub(s.Mul(y)).Add(pair(xfA.P.X, xfB.P.X))
+	wy := s.Mul(x).Add(c.Mul(y)).Add(pair(xfA.P.Y, xfB.P.Y))
+	v.wA, v.wB = Vec.Vector{wx.GetElem(0), wy.GetElem(0)}, Vec.Vector{wx.GetElem(1), wy.GetElem(1)}
+	return true
+}
