new file mode 100644
index 0000000..24fe154
--- /dev/null
+++ b/internal/vector/positions-simd.go
@@ -0,0 +1,54 @@
+//go:build goexperiment.simd && amd64
+
+package vector
+
+import (
+	"github.com/burntcustard/unicorn-mining-co/internal/utilities"
+	"simd/archsimd"
+)
+
+type packedPositions struct{ x, y []float64 }
+
+var vectorObservers = archsimd.X86.AVX2() && utilities.SIMDFeature("observers")
+
+func (p *PositionSet) pack() {
+	if !vectorObservers || len(p.Points) < 5 {
+		return
+	}
+	if len(p.packed.x) < len(p.Points) {
+		p.packed.x = make([]float64, len(p.Points)*2)
+		p.packed.y = make([]float64, len(p.Points)*2)
+	}
+	for i, point := range p.Points {
+		p.packed.x[i], p.packed.y[i] = point.X, point.Y
+	}
+}
+
+func (p *PositionSet) AnyWithin(position Vector, radiusSquared float64) bool {
+	points := p.Points
+	// Convoys usually match their first observer, so retain that cheap exit.
+	if len(points) == 0 {
+		return false
+	}
+	if DistanceSquared(position, points[0]) <= radiusSquared {
+		return true
+	}
+	i := 1
+	if vectorObservers && len(points) >= 5 {
+		x, y, radius := archsimd.BroadcastFloat64x4(position.X), archsimd.BroadcastFloat64x4(position.Y), archsimd.BroadcastFloat64x4(radiusSquared)
+		for ; i+4 <= len(points); i += 4 {
+			dx, dy := x.Sub(archsimd.LoadFloat64x4(p.packed.x[i:])), y.Sub(archsimd.LoadFloat64x4(p.packed.y[i:]))
+			if dx.Mul(dx).Add(dy.Mul(dy)).LessEqual(radius).ToBits() != 0 {
+				archsimd.ClearAVXUpperBits()
+				return true
+			}
+		}
+		archsimd.ClearAVXUpperBits()
+	}
+	for ; i < len(points); i++ {
+		if DistanceSquared(position, points[i]) <= radiusSquared {
+			return true
+		}
+	}
+	return false
+}
