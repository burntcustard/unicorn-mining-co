+package vector
+
+import "math"
+
+// Experimental bounded polynomial; maximum scalar absolute error measured separately.
+func Sincos(angle float64) (float64, float64) {
+ if !(angle >= -32 && angle <= 32) { return math.Sincos(angle) }
+ quadrant := math.RoundToEven(angle * (2 / math.Pi))
+ x := angle - quadrant * (math.Pi / 2)
+ z := x*x
+ sin := x * (1 + z*(-1.0/6 + z*(1.0/120 + z*(-1.0/5040))))
+ cos := 1 + z*(-1.0/2 + z*(1.0/24 + z*(-1.0/720 + z*(1.0/40320))))
+ switch int(quadrant) & 3 {
+ case 1: return cos, -sin
+ case 2: return -sin, -cos
+ case 3: return -cos, sin
+ }
+ return sin, cos
+}
