+package physics
+import "unsafe"
+var Audit = struct { Islands, Contacts, SinglePoint, TwoPoint, SequentialBatches, SequentialSlots4, SequentialSlots8, ColoredBatches, ColoredSlots4, ColoredSlots8 int; IslandSizes map[int]int; BodyBytes, ContactBytes uintptr }{IslandSizes:map[int]int{},BodyBytes:unsafe.Sizeof(Body{}),ContactBytes:unsafe.Sizeof(Contact{})}
+func (s *Solver) auditIsland() {
+ auditContacts=append(auditContacts,s.Contacts...)
+ Audit.Islands++; Audit.Contacts+=len(s.Contacts); Audit.IslandSizes[len(s.Contacts)]++
+ // Measure conflict-free consecutive batches without changing current dependency order.
+ used:=map[*Body]bool{}; count:=0
+ flush:=func(){if count>0 {Audit.SequentialBatches++;Audit.SequentialSlots4+=(count+3)/4*4;Audit.SequentialSlots8+=(count+7)/8*8};clear(used);count=0}
+ colors:=[]map[*Body]bool{}; sizes:=[]int{}
+ for _,c:=range s.Contacts { a,b:=c.FixtureA.Body,c.FixtureB.Body; if c.Manifold.PointCount==1 {Audit.SinglePoint++} else {Audit.TwoPoint++}; if used[a]||used[b] {flush()};used[a]=true;used[b]=true;count++
+  color:=0;for color<len(colors)&&(colors[color][a]||colors[color][b]) {color++};if color==len(colors){colors=append(colors,map[*Body]bool{});sizes=append(sizes,0)};colors[color][a]=true;colors[color][b]=true;sizes[color]++
+ };flush();for _,n:=range sizes {Audit.ColoredBatches++;Audit.ColoredSlots4+=(n+3)/4*4;Audit.ColoredSlots8+=(n+7)/8*8}
+}
+
+var auditContacts []*Contact
+var WorldAudit = struct {Calls, Contacts, SequentialSlots4, SequentialSlots8, ColoredSlots4, ColoredSlots8 int}{}
+func auditWorld() {
+ WorldAudit.Calls++;WorldAudit.Contacts+=len(auditContacts)
+ used:=map[*Body]bool{};n:=0
+ flush:=func(){WorldAudit.SequentialSlots4+=(n+3)/4*4;WorldAudit.SequentialSlots8+=(n+7)/8*8;clear(used);n=0}
+ colors:=[]map[*Body]bool{};sizes:=[]int{}
+ for _,c:=range auditContacts {a,b:=c.FixtureA.Body,c.FixtureB.Body;if used[a]||used[b]{flush()};used[a]=true;used[b]=true;n++
+  k:=0;for k<len(colors)&&(colors[k][a]||colors[k][b]){k++};if k==len(colors){colors=append(colors,map[*Body]bool{});sizes=append(sizes,0)};colors[k][a]=true;colors[k][b]=true;sizes[k]++
+ };flush();for _,v:=range sizes{WorldAudit.ColoredSlots4+=(v+3)/4*4;WorldAudit.ColoredSlots8+=(v+7)/8*8}
+}
