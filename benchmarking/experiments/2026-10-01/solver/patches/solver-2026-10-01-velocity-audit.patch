+package physics
+
+import "math/rand/v2"
+
+type VelocityAuditContact struct {
+	A, B       int
+	Constraint ContactConstraint
+	Friction   float64
+}
+type VelocityAuditSample struct {
+	Bodies     []Velocity
+	Contacts   []VelocityAuditContact
+	Iterations int
+}
+
+var auditSamples [3][]VelocityAuditSample
+var auditCounts [3]int
+var auditRandom = rand.New(rand.NewPCG(71, 23))
+
+func VelocityAuditSamples() any {
+	return struct {
+		Samples [3][]VelocityAuditSample
+		Counts  [3]int
+	}{auditSamples, auditCounts}
+}
+func (s *Solver) auditVelocity(iterations int) {
+	if len(s.Contacts) == 0 {
+		return
+	}
+	kind := 2
+	if len(s.Contacts) == 1 {
+		kind = s.Contacts[0].VPointCount - 1
+	}
+	auditCounts[kind]++
+	index := auditCounts[kind] - 1
+	if index >= 512 {
+		index = auditRandom.IntN(auditCounts[kind])
+		if index >= 512 {
+			return
+		}
+	}
+	sample := VelocityAuditSample{Iterations: iterations}
+	indexes := map[*Body]int{}
+	for i, b := range s.Bodies {
+		indexes[b] = i
+		sample.Bodies = append(sample.Bodies, b.CVelocity)
+	}
+	for _, c := range s.Contacts {
+		sample.Contacts = append(sample.Contacts, VelocityAuditContact{indexes[c.NodeB.Other], indexes[c.NodeA.Other], *c.ContactConstraint, c.Friction})
+	}
+	if index == len(auditSamples[kind]) {
+		auditSamples[kind] = append(auditSamples[kind], sample)
+	} else {
+		auditSamples[kind][index] = sample
+	}
+}
