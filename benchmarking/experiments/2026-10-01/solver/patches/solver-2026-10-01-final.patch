+				if schedule.withinObservers(position, radius) != schedule.withinObserversScalar(position, radius) {
+					t.Fatalf("count=%d origin=%g trial=%d radius=%g", count, origin, trial, radius)
+				}
+			}
+		}
+	}
+}
