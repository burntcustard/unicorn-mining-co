+
+// Rank body neighbors once, sharing the result across all their fixtures.
+// Contacts remain cached so a deferred neighbor is reconsidered next update.
+func (w *World) prepareCollisionNeighbors() {
+	for body := w.BodyList; body != nil; body = body.Next {
+		body.Neighborhood = nil
+		var unique [8]*Body
+		count := 0
+		crowded := false
+		for edge := body.ContactList; edge != nil; edge = edge.Next {
+			seen := false
+			for _, other := range unique[:count] {
+				if edge.Other == other { seen = true; break }
+			}
+			if seen { continue }
+			if count == 8 { crowded = true; break }
+			unique[count] = edge.Other
+			count++
+		}
+		if !crowded { continue }
+		if body.neighborhoodCache == nil { body.neighborhoodCache = &CollisionNeighborhood{} }
+		body.Neighborhood = body.neighborhoodCache
+		*body.Neighborhood = CollisionNeighborhood{}
+		var last *Body
+		for edge := body.ContactList; edge != nil; edge = edge.Next {
+			other := edge.Other
+			if other == last { continue }
+			last = other
+			if body.AllowsCollision(other) { continue }
+			dx, dy := body.Xf.P.X-other.Xf.P.X, body.Xf.P.Y-other.Xf.P.Y
+			body.AddCollisionNeighbor(other, dx*dx+dy*dy)
+		}
+	}
+}
