+//go:build goexperiment.simd && amd64
+
+package physics
+
+import "simd/archsimd"
+
+func solveBatch64(contacts []*Contact, iterations int) {
+	var vax, vay, wa, vbx, vby, wb, nx, ny, rax, ray, rbx, rby, ma, mb, ia, ib, tm, nm, bias, friction, ti, ni [4]float64
+	for lane, c := range contacts {
+		a, b, p := c.FixtureA.Body, c.FixtureB.Body, &c.VPoints[0]
+		vax[lane] = float64(a.CVelocity.V.X)
+		vay[lane] = float64(a.CVelocity.V.Y)
+		wa[lane] = float64(a.CVelocity.W)
+		vbx[lane] = float64(b.CVelocity.V.X)
+		vby[lane] = float64(b.CVelocity.V.Y)
+		wb[lane] = float64(b.CVelocity.W)
+		nx[lane] = float64(c.VNormal.X)
+		ny[lane] = float64(c.VNormal.Y)
+		rax[lane] = float64(p.RA.X)
+		ray[lane] = float64(p.RA.Y)
+		rbx[lane] = float64(p.RB.X)
+		rby[lane] = float64(p.RB.Y)
+		ma[lane] = float64(c.InvMassA)
+		mb[lane] = float64(c.InvMassB)
+		ia[lane] = float64(c.InvIA)
+		ib[lane] = float64(c.InvIB)
+		tm[lane] = float64(p.TangentMass)
+		nm[lane] = float64(p.NormalMass)
+		bias[lane] = float64(p.VelocityBias)
+		friction[lane] = float64(c.Friction)
+		ti[lane] = float64(p.TangentImpulse)
+		ni[lane] = float64(p.NormalImpulse)
+	}
+	batchKernel64(&vax, &vay, &wa, &vbx, &vby, &wb, &nx, &ny, &rax, &ray, &rbx, &rby, &ma, &mb, &ia, &ib, &tm, &nm, &bias, &friction, &ti, &ni, iterations)
+	for lane, c := range contacts {
+		a, b, p := c.FixtureA.Body, c.FixtureB.Body, &c.VPoints[0]
+		a.CVelocity.V.X = float64(vax[lane])
+		a.CVelocity.V.Y = float64(vay[lane])
+		a.CVelocity.W = float64(wa[lane])
+		b.CVelocity.V.X = float64(vbx[lane])
+		b.CVelocity.V.Y = float64(vby[lane])
+		b.CVelocity.W = float64(wb[lane])
+		p.TangentImpulse = float64(ti[lane])
+		p.NormalImpulse = float64(ni[lane])
+	}
+}
+
+//go:noinline
+func batchKernel64(pvax, pvay, pwa, pvbx, pvby, pwb, pnx, pny, prax, pray, prbx, prby, pma, pmb, pia, pib, ptm, pnm, pbias, pfriction, pti, pni *[4]float64, iterations int) {
+	vax := archsimd.LoadFloat64x4Array(pvax)
+	vay := archsimd.LoadFloat64x4Array(pvay)
+	wa := archsimd.LoadFloat64x4Array(pwa)
+	vbx := archsimd.LoadFloat64x4Array(pvbx)
+	vby := archsimd.LoadFloat64x4Array(pvby)
+	wb := archsimd.LoadFloat64x4Array(pwb)
+	nx := archsimd.LoadFloat64x4Array(pnx)
+	ny := archsimd.LoadFloat64x4Array(pny)
+	rax := archsimd.LoadFloat64x4Array(prax)
+	ray := archsimd.LoadFloat64x4Array(pray)
+	rbx := archsimd.LoadFloat64x4Array(prbx)
+	rby := archsimd.LoadFloat64x4Array(prby)
+	ma := archsimd.LoadFloat64x4Array(pma)
+	mb := archsimd.LoadFloat64x4Array(pmb)
+	ia := archsimd.LoadFloat64x4Array(pia)
+	ib := archsimd.LoadFloat64x4Array(pib)
+	tm := archsimd.LoadFloat64x4Array(ptm)
+	nm := archsimd.LoadFloat64x4Array(pnm)
+	bias := archsimd.LoadFloat64x4Array(pbias)
+	friction := archsimd.LoadFloat64x4Array(pfriction)
+	ti := archsimd.LoadFloat64x4Array(pti)
+	ni := archsimd.LoadFloat64x4Array(pni)
+	zero := archsimd.BroadcastFloat64x4(0)
+	for i := 0; i < iterations; i++ {
+		tx := ny
+		ty := zero.Sub(nx)
+		dx := vbx.Add(zero.Sub(wb).Mul(rby)).Sub(vax).Sub(zero.Sub(wa).Mul(ray))
+		dy := vby.Add(wb.Mul(rbx)).Sub(vay).Sub(wa.Mul(rax))
+		vt := dx.Mul(tx).Add(dy.Mul(ty))
+		impulse := tm.Mul(zero.Sub(vt))
+		limit := friction.Mul(ni)
+		next := zero.Sub(limit).Max(ti.Add(impulse).Min(limit))
+		impulse = next.Sub(ti)
+		ti = next
+		px := tx.Mul(impulse)
+		py := ty.Mul(impulse)
+		vax = vax.Add(px.Mul(zero.Sub(ma)))
+		vay = vay.Add(py.Mul(zero.Sub(ma)))
+		wa = wa.Sub(ia.Mul(rax.Mul(py).Sub(ray.Mul(px))))
+		vbx = vbx.Add(px.Mul(mb))
+		vby = vby.Add(py.Mul(mb))
+		wb = wb.Add(ib.Mul(rbx.Mul(py).Sub(rby.Mul(px))))
+		dx = vbx.Add(zero.Sub(wb).Mul(rby)).Sub(vax).Sub(zero.Sub(wa).Mul(ray))
+		dy = vby.Add(wb.Mul(rbx)).Sub(vay).Sub(wa.Mul(rax))
+		vn := dx.Mul(nx).Add(dy.Mul(ny))
+		impulse = zero.Sub(nm).Mul(vn.Sub(bias))
+		next = ni.Add(impulse).Max(zero)
+		impulse = next.Sub(ni)
+		ni = next
+		px = nx.Mul(impulse)
+		py = ny.Mul(impulse)
+		vax = vax.Add(px.Mul(zero.Sub(ma)))
+		vay = vay.Add(py.Mul(zero.Sub(ma)))
+		wa = wa.Sub(ia.Mul(rax.Mul(py).Sub(ray.Mul(px))))
+		vbx = vbx.Add(px.Mul(mb))
+		vby = vby.Add(py.Mul(mb))
+		wb = wb.Add(ib.Mul(rbx.Mul(py).Sub(rby.Mul(px))))
+	}
+	vax.StoreArray(pvax)
+	vay.StoreArray(pvay)
+	wa.StoreArray(pwa)
+	vbx.StoreArray(pvbx)
+	vby.StoreArray(pvby)
+	wb.StoreArray(pwb)
+	ti.StoreArray(pti)
+	ni.StoreArray(pni)
+	archsimd.ClearAVXUpperBits()
+}
