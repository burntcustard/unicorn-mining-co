index 0000000..d0bf31c
--- /dev/null
+++ b/internal/server/replication-simd.go
@@ -0,0 +1,42 @@
+//go:build goexperiment.simd && amd64
+
+package server
+
+import (
+	"github.com/burntcustard/unicorn-mining-co/internal/utilities"
+	Vec "github.com/burntcustard/unicorn-mining-co/internal/vector"
+	"simd/archsimd"
+	"unsafe"
+)
+
+var vectorReplication = archsimd.X86.AVX2() && utilities.SIMDFeature("replication")
+
+func (v *ReplicationView) packReplicationPolicy(count int) {
+	if !vectorReplication {
+		return
+	}
+	if cap(v.IDs) < count {
+		v.IDs = make([]int64, count*2)
+		v.unloadSquared = make([]float64, count*2)
+	}
+	v.IDs, v.unloadSquared = v.IDs[:count], v.unloadSquared[:count]
+}
+
+func (v *ReplicationView) replicationBlock(index int, position Vec.Vector, shipID int64, distances *[4]float64) uint8 {
+	// Entities prepares equally sized arrays, and the caller checks index+4.
+	load := func(values []float64) archsimd.Float64x4 {
+		return archsimd.LoadFloat64x4Array((*[4]float64)(unsafe.Add(unsafe.Pointer(unsafe.SliceData(values)), index*8)))
+	}
+	dx := load(v.X).Sub(archsimd.BroadcastFloat64x4(position.X))
+	dy := load(v.Y).Sub(archsimd.BroadcastFloat64x4(position.Y))
+	distance := dx.Mul(dx).Add(dy.Mul(dy))
+	far := distance.Greater(load(v.unloadSquared)).ToBits()
+	ids := archsimd.LoadInt64x4Array((*[4]int64)(unsafe.Add(unsafe.Pointer(unsafe.SliceData(v.IDs)), index*8)))
+	owned := ids.Equal(archsimd.BroadcastInt64x4(shipID)).ToBits()
+	far &^= owned
+	if far != 15 {
+		distance.StoreArray(distances)
+	}
+	archsimd.ClearAVXUpperBits()
+	return far
+}
