diff --git a/internal/collision/shape/polygon-separation_test.go b/internal/collision/shape/polygon-separation_test.go
new file mode 100644
index 0000000..430301b
--- /dev/null
+++ b/internal/collision/shape/polygon-separation_test.go
@@ -0,0 +1,85 @@
+package shape
+
+import (
+	Vec "github.com/burntcustard/unicorn-mining-co/internal/vector"
+	"math"
+	"math/rand/v2"
+	"testing"
+	"unsafe"
+)
+
+func TestPolygonSeparationThresholds(t *testing.T) {
+	r := rand.New(rand.NewPCG(25, 31))
+	makePolygon := func(count int) *PolygonShape {
+		vertices := make([]Vec.Vector, count)
+		for i := range vertices {
+			angle := float64(i) * 2 * math.Pi / float64(count)
+			vertices[i] = Vec.Create(20*math.Cos(angle), 13*math.Sin(angle))
+		}
+		return NewPolygon(vertices, nil, 0.1)
+	}
+	for _, countA := range []int{3, 4, 5, 8, 9, 16} {
+		for _, countB := range []int{3, 4, 5, 8, 9, 16} {
+			a, b := makePolygon(countA), makePolygon(countB)
+			for range 300 {
+				xfA := Vec.Transform(r.Float64()*100-50, r.Float64()*100-50, r.Float64()*6-3)
+				xfB := Vec.Transform(r.Float64()*100-50, r.Float64()*100-50, r.Float64()*6-3)
+				_, separation := findMaxSeparationScalar(a, xfA, b, xfB, math.Inf(1))
+				for _, limit := range []float64{0, 0.4, separation, math.Nextafter(separation, math.Inf(-1)), math.Nextafter(separation, math.Inf(1))} {
+					wantIndex, want := findMaxSeparationScalar(a, xfA, b, xfB, limit)
+					gotIndex, got := findMaxSeparation(a, xfA, b, xfB, limit)
+					if gotIndex != wantIndex || math.Float64bits(got) != math.Float64bits(want) {
+						t.Fatalf("counts %d/%d limit %.17g: got %d/%.17g want %d/%.17g", countA, countB, limit, gotIndex, got, wantIndex, want)
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestPolygonSeparationTiesAndNonfinite(t *testing.T) {
+	if unsafe.Sizeof(Vec.Vector{}) != 16 || unsafe.Offsetof(Vec.Vector{}.Y) != 8 {
+		t.Fatal("SIMD loads require consecutive X and Y float64 fields")
+	}
+	for _, points := range [][]Vec.Vector{nil, {{X: 10}, {Y: 10}, {X: -10}}} {
+		a, b := NewPolygon(points, nil, 0.1), NewPolygon(points, nil, 0.1)
+		if points == nil {
+			a.SetAsBox(10, 10)
+			b.SetAsBox(10, 10)
+		}
+		xf := Vec.Transform(0, 0, 0)
+		for _, target := range []*PolygonShape{a, b} {
+			for _, value := range []float64{0, math.Copysign(0, -1), math.NaN(), math.Inf(1), math.Inf(-1)} {
+				for i := range target.Vertices {
+					original := target.Vertices[i]
+					target.Vertices[i].X = value
+					for _, limit := range []float64{0, 0.4, math.Inf(1)} {
+						wantIndex, want := findMaxSeparationScalar(a, xf, b, xf, limit)
+						gotIndex, got := findMaxSeparation(a, xf, b, xf, limit)
+						if gotIndex != wantIndex || math.Float64bits(got) != math.Float64bits(want) {
+							t.Fatalf("count=%d value=%v index=%d: got %d/%v want %d/%v", a.Count, value, i, gotIndex, got, wantIndex, want)
+						}
+					}
+					target.Vertices[i] = original
+				}
+			}
+		}
+	}
+}
+
+func BenchmarkPolygonSeparation(b *testing.B) {
+	a, target := NewPolygon(nil, nil, 0.1), NewPolygon(nil, nil, 0.1)
+	a.SetAsBox(10, 8)
+	target.SetAsBox(9, 6)
+	xfA, xfB := Vec.Transform(0, 0, 0.2), Vec.Transform(10, 3, -0.3)
+	b.Run("scalar", func(b *testing.B) {
+		for b.Loop() {
+			findMaxSeparationScalar(a, xfA, target, xfB, 0.4)
+		}
+	})
+	b.Run("selected", func(b *testing.B) {
+		for b.Loop() {
+			findMaxSeparation(a, xfA, target, xfB, 0.4)
+		}
+	})
+}
diff --git a/internal/collision/shape/polygon-simd.go b/internal/collision/shape/polygon-simd.go
new file mode 100644
index 0000000..b1dfa9b
--- /dev/null
+++ b/internal/collision/shape/polygon-simd.go
@@ -0,0 +1,85 @@
+//go:build goexperiment.simd && amd64
+
+package shape
+
+import (
+	"github.com/burntcustard/unicorn-mining-co/internal/utilities"
+	Vec "github.com/burntcustard/unicorn-mining-co/internal/vector"
+	"math"
+	"simd/archsimd"
+	"unsafe"
+)
+
+var triangleSIMD = archsimd.X86.AVX2() && utilities.SIMDFeature("triangles")
+
+func findMaxSeparation(a *PolygonShape, xfA Vec.TransformValue, b *PolygonShape, xfB Vec.TransformValue, limit float64) (int, float64) {
+	if triangleSIMD && a.Count == 3 && b.Count == 3 {
+		return findTriangleSeparation(a, xfA, b, xfB, limit)
+	}
+	return findMaxSeparationScalar(a, xfA, b, xfB, limit)
+}
+
+func findTriangleSeparation(a *PolygonShape, xfA Vec.TransformValue, b *PolygonShape, xfB Vec.TransformValue, limit float64) (int, float64) {
+	var xf Vec.TransformValue
+	var normal, vertex Vec.Vector
+	Vec.DetransformTransform(&xf, xfB, xfA)
+	// Preserve the first-axis rejection before batching the remaining axes.
+	Vec.RotateInto(&normal, xf.Q, a.Normals[0])
+	Vec.TransformInto(&vertex, xf, a.Vertices[0])
+	offset := Vec.Dot(normal, vertex)
+	best := math.Inf(1)
+	vertices := b.Vertices[:3]
+	projectScalar := func(v Vec.Vector) {
+		value := Vec.Dot(normal, v) - offset
+		if value < best {
+			best = value
+		}
+	}
+	projectScalar(vertices[0])
+	projectScalar(vertices[1])
+	projectScalar(vertices[2])
+	if best > limit {
+		return 0, best
+	}
+	c, s := archsimd.BroadcastFloat64x2(xf.Q.C), archsimd.BroadcastFloat64x2(xf.Q.S)
+	// Read the existing two-float vectors directly; no extra geometry cache.
+	loadPair := func(points []Vec.Vector) (archsimd.Float64x2, archsimd.Float64x2) {
+		a := archsimd.LoadFloat64x2Array((*[2]float64)(unsafe.Pointer(&points[1])))
+		b := archsimd.LoadFloat64x2Array((*[2]float64)(unsafe.Pointer(&points[2])))
+		return a.ConcatPermuteScalars(0, 2, b), a.ConcatPermuteScalars(1, 3, b)
+	}
+	x, y := loadPair(a.Vertices)
+	nx, ny := loadPair(a.Normals)
+	rx, ry := c.Mul(nx).Sub(s.Mul(ny)), s.Mul(nx).Add(c.Mul(ny))
+	vx := c.Mul(x).Sub(s.Mul(y)).Add(archsimd.BroadcastFloat64x2(xf.P.X))
+	vy := s.Mul(x).Add(c.Mul(y)).Add(archsimd.BroadcastFloat64x2(xf.P.Y))
+	voffset := rx.Mul(vx).Add(ry.Mul(vy))
+	project := func(v Vec.Vector) archsimd.Float64x2 {
+		return rx.Mul(archsimd.BroadcastFloat64x2(v.X)).Add(ry.Mul(archsimd.BroadcastFloat64x2(v.Y))).Sub(voffset)
+	}
+	minimum := func(before, next archsimd.Float64x2) archsimd.Float64x2 {
+		return next.IfElse(next.Less(before), before)
+	}
+	// Explicit ordered selection preserves the previous value on ties and NaNs.
+	// The experimental compiler can exchange operands of the Min intrinsic.
+	separation := minimum(archsimd.BroadcastFloat64x2(math.Inf(1)), project(vertices[0]))
+	separation = minimum(separation, project(vertices[1]))
+	separation = minimum(separation, project(vertices[2]))
+	index := 0
+	// This kernel uses only XMM registers, so it does not dirty upper AVX lanes.
+	var lanes [2]float64
+	separation.StoreArray(&lanes)
+	if lanes[0] > limit {
+		return 1, lanes[0]
+	}
+	if lanes[0] > best {
+		index, best = 1, lanes[0]
+	}
+	if lanes[1] > limit {
+		return 2, lanes[1]
+	}
+	if lanes[1] > best {
+		index, best = 2, lanes[1]
+	}
+	return index, best
+}
