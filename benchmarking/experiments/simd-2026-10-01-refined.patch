@@ -0,0 +1,12 @@
+package vector
+
+type PositionSet struct {
+	Points []Vector
+	packed packedPositions
+}
+
+// Set borrows points until the next call. Call it again after moving a point.
+func (p *PositionSet) Set(points []Vector) {
+	p.Points = points
+	p.pack()
+}
