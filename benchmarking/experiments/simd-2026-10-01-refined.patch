diff --git a/internal/vector/positions-simd.go b/internal/vector/positions-simd.go
new file mode 100644
index 0000000..1146f31
--- /dev/null
+++ b/internal/vector/positions-simd.go
@@ -0,0 +1,68 @@
+//go:build goexperiment.simd && amd64
+
+package vector
+
+import (
+	"github.com/burntcustard/unicorn-mining-co/internal/utilities"
+	"simd/archsimd"
+	"unsafe"
+)
+
+type packedPositions struct{ x, y []float64 }
+
+var vectorObservers = archsimd.X86.AVX2() && utilities.SIMDFeature("observers")
+
+func (p *PositionSet) pack() {
+	if !vectorObservers || len(p.Points) < 5 {
+		return
+	}
+	if len(p.packed.x) < len(p.Points) {
+		p.packed.x = make([]float64, len(p.Points)*2)
+		p.packed.y = make([]float64, len(p.Points)*2)
+	}
+	for i, point := range p.Points {
+		p.packed.x[i], p.packed.y[i] = point.X, point.Y
+	}
+}
+
+func (p *PositionSet) AnyWithin(position Vector, radiusSquared float64) bool {
+	points := p.Points
+	if len(points) == 0 {
+		return false
+	}
+	// Preserve the cheap first-observer exit for convoys.
+	if DistanceSquared(position, points[0]) <= radiusSquared {
+		return true
+	}
+	if !vectorObservers || len(points) < 5 {
+		for _, point := range points[1:] {
+			if DistanceSquared(position, point) <= radiusSquared {
+				return true
+			}
+		}
+		return false
+	}
+	// Test the incomplete tail before entering AVX. Nothing floating point needs
+	// to survive ClearAVXUpperBits, so the compiler cannot spill it using legacy
+	// SSE instructions while upper AVX registers are still dirty.
+	end := 1 + ((len(points)-1)/4)*4
+	for _, point := range points[end:] {
+		if DistanceSquared(position, point) <= radiusSquared {
+			return true
+		}
+	}
+	// Validate once; every vector below covers four points inside these arrays.
+	px, py := p.packed.x[:end], p.packed.y[:end]
+	xBase, yBase := unsafe.Pointer(unsafe.SliceData(px)), unsafe.Pointer(unsafe.SliceData(py))
+	x, y, radius := archsimd.BroadcastFloat64x4(position.X), archsimd.BroadcastFloat64x4(position.Y), archsimd.BroadcastFloat64x4(radiusSquared)
+	for i := 1; i < end; i += 4 {
+		dx := x.Sub(archsimd.LoadFloat64x4Array((*[4]float64)(unsafe.Add(xBase, i*8))))
+		dy := y.Sub(archsimd.LoadFloat64x4Array((*[4]float64)(unsafe.Add(yBase, i*8))))
+		if dx.Mul(dx).Add(dy.Mul(dy)).LessEqual(radius).ToBits() != 0 {
+			archsimd.ClearAVXUpperBits()
+			return true
+		}
+	}
+	archsimd.ClearAVXUpperBits()
+	return false
+}
