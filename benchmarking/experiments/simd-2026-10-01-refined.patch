+package simulation
+
+import (
+	"github.com/burntcustard/unicorn-mining-co/internal/utilities"
+	Vec "github.com/burntcustard/unicorn-mining-co/internal/vector"
+	"math"
+	"math/rand/v2"
+	"testing"
+	"unsafe"
+)
+
+func TestMotionFieldLayout(t *testing.T) {
+	var o GameObject
+	start := unsafe.Offsetof(o.Position)
+	if unsafe.Sizeof(o.Position) != 16 || unsafe.Offsetof(o.Velocity) != start+16 || unsafe.Offsetof(o.Rotation) != start+32 || unsafe.Offsetof(o.Spin) != start+40 {
+		t.Fatal("motion fields are not contiguous")
+	}
+}
+
+func TestMotionRoundingBits(t *testing.T) {
+	values := []float64{0, math.Copysign(0, -1), 0.5e-8, -0.5e-8, math.NaN(), math.Inf(1), math.Inf(-1), math.SmallestNonzeroFloat64, math.MaxFloat64}
+	r := rand.New(rand.NewPCG(25, 31))
+	for range 10000 {
+		values = append(values, r.Float64()*22000-11000)
+	}
+	for _, value := range values {
+		o := GameObject{Position: Vec.Create(value, value), Velocity: Vec.Create(value, value), Rotation: value, Spin: value}
+		want := utilities.RoundMotion(value)
+		o.RoundMotion()
+		for _, got := range []float64{o.Position.X, o.Position.Y, o.Velocity.X, o.Velocity.Y, o.Rotation, o.Spin} {
+			if math.Float64bits(got) != math.Float64bits(want) {
+				t.Fatalf("rounding %.17g: got %x want %x", value, math.Float64bits(got), math.Float64bits(want))
+			}
+		}
+	}
+}
