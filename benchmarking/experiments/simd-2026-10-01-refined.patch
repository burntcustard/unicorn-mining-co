--- /dev/null
+++ b/internal/vector/positions_test.go
@@ -0,0 +1,44 @@
+package vector
+
+import (
+	"math"
+	"math/rand/v2"
+	"testing"
+)
+
+func TestPositionSet(t *testing.T) {
+	r := rand.New(rand.NewPCG(19, 31))
+	var set PositionSet
+	for repeat := range 3 {
+		for n := 128; n >= 0; n-- {
+			points := make([]Vector, n)
+			for i := range points {
+				points[i] = Vector{r.Float64()*1000 - 500, r.Float64()*1000 - 500}
+			}
+			if n > 0 && repeat == 1 {
+				points[0].X = math.NaN()
+			}
+			set.Set(points)
+			for trial := range 30 {
+				p := Vector{r.Float64()*1000 - 500, r.Float64()*1000 - 500}
+				radius := r.Float64() * 100000
+				if n > 0 {
+					radius = DistanceSquared(p, points[trial%n])
+					if trial%3 == 1 {
+						radius = math.Nextafter(radius, math.Inf(-1))
+					}
+					if trial%3 == 2 {
+						radius = math.Nextafter(radius, math.Inf(1))
+					}
+				}
+				want := false
+				for _, point := range points {
+					want = want || DistanceSquared(p, point) <= radius
+				}
+				if got := set.AnyWithin(p, radius); got != want {
+					t.Fatalf("repeat=%d n=%d trial=%d got=%v want=%v", repeat, n, trial, got, want)
+				}
+			}
+		}
+	}
+}
