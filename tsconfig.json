{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ES2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "target": "ES2024"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "plugins/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts",
    "benchmarking/tools/**/*.ts",
    "benchmarking/experiments/**/*.ts"
  ]
}
